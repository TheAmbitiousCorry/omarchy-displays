#!/usr/bin/env bash
set -euo pipefail

# omarchy:summary=Show, apply, confirm, revert, and persist Hyprland monitor layouts
# omarchy:args=state | apply PROFILE.json [--timeout N] | confirm | revert | status | persist [PROFILE.json] | profile list|show|save|delete|activate|match | doctor | version | help
# omarchy:examples=omarchy displays state | omarchy displays apply desk.json | omarchy displays apply desk.json --timeout 30 | omarchy displays confirm | omarchy displays revert | omarchy displays status | omarchy displays persist | omarchy displays persist desk.json | omarchy displays profile list | omarchy displays profile save desk.json --activate | omarchy displays profile match | omarchy displays doctor

VERSION=0.1.0
SELF=$(readlink -f "${BASH_SOURCE[0]}")
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-displays"
LOCK="$RUNDIR/countdown"
LAST_APPLIED="$RUNDIR/last-applied.json"
HYPR_DIR="${OMARCHY_DISPLAYS_HYPR_DIR:-$HOME/.config/hypr}"
LOADER_LINE='pcall(require, "hypr.displays")'
DEFAULT_TIMEOUT=15
KEEP_BACKUPS=10
CONFIG_DIR="${OMARCHY_DISPLAYS_CONFIG_DIR:-$HOME/.config/omarchy/displays}"
PROFILES="$CONFIG_DIR/profiles"
ACTIVE="$CONFIG_DIR/active"
TMP_FILE=
trap '[[ -z $TMP_FILE ]] || rm -f "$TMP_FILE"' EXIT

# EDID strings are attacker-controlled and end up inside a Lua string handed to
# eval, so only these characters may pass. jq's `$` also matches before a
# trailing newline, hence the explicit newline test in the validator.
STRING_RE='^[A-Za-z0-9 ._:@/+-]+$'
NUMBER_RE='^-?[0-9]+(\.[0-9]+)?$'
# A profile name becomes a filename: no leading dot, slash or space, and no
# trailing space.
NAME_RE='^[A-Za-z0-9]([A-Za-z0-9 _-]{0,38}[A-Za-z0-9_-])?$'

usage() {
  cat <<'EOF'
Usage: omarchy-displays <command>
  state                           connected monitors as JSON, each with a derived identity
  apply PROFILE.json [--timeout N]  apply live, then revert after N seconds (default 15) unless confirmed
  confirm                         keep the applied layout
  revert                          reload the Hyprland config, undoing any unconfirmed change
  status                          the live countdown as JSON: pid, deadline, seconds remaining
  persist [PROFILE.json]          write displays.lua from a profile (default: the last applied, else the active) and reload
  profile list                    saved profiles as JSON: name, active, identities, modified
  profile show NAME               one saved profile
  profile save FILE [--name N] [--activate]  store a profile, optionally making it the active one
  profile delete NAME             remove a saved profile
  profile activate NAME           mark a saved profile as the active one
  profile match                   print the saved profile whose monitors are exactly the connected ones; exit 1 if none
  doctor                          check that hyprland.lua loads displays.lua and the running config has it
  loader-line                     print the line hyprland.lua must contain
  version                         print the version
  help                            this text
EOF
}

reject() {
  echo "omarchy-displays: $*" >&2
  exit 3
}

# Prints the countdown's pid and succeeds only while that process is alive, so
# a lock left behind by a crash or reboot counts as no countdown.
live_countdown_pid() {
  local pid
  [[ -f $LOCK/pid ]] || return 1
  pid=$(<"$LOCK/pid") || return 1
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

cmd_state() {
  local monitors
  monitors=$(hyprctl -j monitors all)
  jq '
    (map("\(.make) \(.model)") | group_by(.) | map({key: .[0], value: length}) | from_entries) as $count
    | map(
        if (.serial // "") != "" then . + {identity: "desc:\(.description)"}
        elif $count["\(.make) \(.model)"] == 1 then . + {identity: "desc:\(.make) \(.model)"}
        else . + {identity: .name,
                  identityWarning: "duplicate make and model without serial; matched by connector"}
        end)
  ' <<<"$monitors"
}

# Prints one problem per line; no output means the profile is safe to write
# into Lua. Every string and number that reaches Lua is checked here. mode,
# position and scale are required only on an enabled monitor.
VALIDATE='
  def str_ok: type == "string" and test($str_re) and (contains("\n") | not);
  def num_ok: type == "number" and (tojson | test($num_re));
  if type != "object" then "profile must be a JSON object"
  else
    (if .schemaVersion == 1 then empty else "schemaVersion must be 1" end),
    (if (.name | str_ok) then empty else "name must be a string of [A-Za-z0-9 ._:@/+-]" end),
    (if (.monitors | type) == "array" and (.monitors | length) > 0
     then empty else "monitors must be a non-empty array" end),
    (.monitors | if type == "array" then to_entries[] else empty end
     | .key as $i | .value as $m
     | if ($m | type) != "object" then "monitors[\($i)] must be an object"
       else
         (if ($m | has("identity")) and ($m.identity | str_ok) then empty
          else "monitors[\($i)].identity must be a string of [A-Za-z0-9 ._:@/+-]" end),
         (if ($m.enabled | type) == "boolean" then empty
          else "monitors[\($i)].enabled must be true or false" end),
         (["mode", "position"][] as $k
          | if ($m | has($k)) then (if ($m[$k] | str_ok) then empty else "bad" end)
            elif $m.enabled == true then "bad" else empty end
          | "monitors[\($i)].\($k) must be a string of [A-Za-z0-9 ._:@/+-]"),
         (if ($m | has("scale")) then (if ($m.scale | num_ok) then empty else "bad" end)
          elif $m.enabled == true then "bad" else empty end
          | "monitors[\($i)].scale must be a plain number"),
         (["mirror", "cm"][] as $k
          | if $m[$k] != null and (($m[$k] | str_ok) | not)
            then "monitors[\($i)].\($k) must be null or a string of [A-Za-z0-9 ._:@/+-]" else empty end),
         (["transform", "vrr", "bitdepth", "sdrbrightness", "sdrsaturation"][] as $k
          | if $m[$k] != null and (($m[$k] | num_ok) | not)
            then "monitors[\($i)].\($k) must be null or a plain number" else empty end)
       end)
  end
'

# One hl.monitor call per monitor. A disabled monitor carries only output and
# disabled: a mode on a disabled output would re-enable it.
RULES='
  def q: "\"" + . + "\"";
  .monitors[] as $m
  | (["output = \($m.identity | q)"]
     + (if $m.enabled then
          ["mode = \($m.mode | q)", "position = \($m.position | q)", "scale = \($m.scale | tojson)"]
          + [["transform", "mirror", "vrr", "bitdepth", "cm", "sdrbrightness", "sdrsaturation"][] as $k
             | select($m[$k] != null)
             | $m[$k] | if type == "string" then "\($k) = \(q)" else "\($k) = \(tojson)" end]
        else ["disabled = true"] end))
  | "hl.monitor({ " + join(", ") + " })"
'

# Prints one problem per line for a readable profile file; no output means
# every string and number in it is safe to write into Lua.
profile_problems() {
  jq -r --arg str_re "$STRING_RE" --arg num_re "$NUMBER_RE" "$VALIDATE" "$1"
}

# Exits 3 with the problems on stderr unless the file is a profile whose every
# string and number is safe to write into Lua.
validate_profile() {
  local file=$1 problems
  [[ -f $file ]] || reject "no such file: $file"
  jq empty "$file" 2>/dev/null || reject "$file is not valid JSON"
  problems=$(profile_problems "$file")
  if [[ -n $problems ]]; then
    echo "omarchy-displays: refusing $file:" >&2
    sed 's/^/  /' <<<"$problems" >&2
    exit 3
  fi
}

# The only producer of rule lines: apply evals them and persist writes them.
# With an identity, only that monitor's rule.
rules_of() {
  jq -r --arg only "${2:-}" \
    "(if \$only != \"\" then .monitors |= ([.[] | select(.identity == \$only)] | .[:1]) else . end) | $RULES" "$1"
}

cmd_apply() {
  local file="" timeout=$DEFAULT_TIMEOUT
  while (($#)); do
    case $1 in
      --timeout)
        [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 >= 1)) || reject "--timeout needs a positive integer"
        timeout=$((10#$2))
        shift 2
        ;;
      -*) reject "unknown option $1" ;;
      *)
        [[ -z $file ]] || reject "apply takes one profile file"
        file=$1
        shift
        ;;
    esac
  done
  [[ -n $file ]] || reject "apply needs a profile file"
  validate_profile "$file"

  local rules
  mapfile -t rules < <(rules_of "$file")

  # mkdir is the only arbiter: a liveness check before it would let two
  # concurrent applies both clear a stale lock and both win.
  local pid
  mkdir -p "$(dirname "$LOCK")"
  if ! mkdir "$LOCK" 2>/dev/null; then
    if pid=$(live_countdown_pid); then
      echo "a countdown is already running (pid $pid); confirm or revert first"
      exit 2
    fi
    rm -rf "$LOCK"
    if ! mkdir "$LOCK" 2>/dev/null; then
      echo "a countdown is already running; confirm or revert first"
      exit 2
    fi
  fi
  # Our own pid holds the lock until the countdown exists, so a concurrent
  # apply never sees a lock without a live owner.
  echo $$ >"$LOCK/pid"

  local rule reply
  for rule in "${rules[@]}"; do
    # `hyprctl keyword monitor` is rejected under the Lua config; eval is the
    # only live path.
    if ! reply=$(hyprctl eval "$rule") || [[ $reply != ok ]]; then
      hyprctl reload >/dev/null || true
      rm -rf "$LOCK"
      echo "omarchy-displays: hyprctl eval failed (${reply:-no reply}); config reloaded" >&2
      exit 1
    fi
  done

  # Kept outside the lock so it survives confirm, which is when persist reads it.
  [[ $file -ef $LAST_APPLIED ]] || cp -f "$file" "$LAST_APPLIED"

  # setsid gives the countdown its own session, so it outlives whatever
  # launched apply (a shell panel, a terminal) and still reverts on time.
  echo $(($(date +%s) + timeout)) >"$LOCK/deadline"
  setsid bash "$SELF" _countdown "$LOCK" "$timeout" </dev/null >/dev/null 2>&1 &
  echo $! >"$LOCK/pid"
  echo "applied ${#rules[@]} monitors; countdown ${timeout}s (pid $!)"
}

cmd_status() {
  local pid deadline now
  if pid=$(live_countdown_pid) && [[ -f $LOCK/deadline ]] && deadline=$(<"$LOCK/deadline") &&
    [[ $deadline =~ ^[0-9]+$ ]]; then
    now=$(date +%s)
    jq -n --argjson pid "$pid" --argjson deadline "$deadline" --argjson now "$now" \
      '{countdown: {pid: $pid, deadline: $deadline, remaining: ([0, $deadline - $now] | max)}}'
  else
    jq -n '{countdown: null}'
  fi
}

cmd_countdown() {
  local lock=$1 timeout=$2 i
  for ((i = 0; i < timeout * 5; i++)); do
    [[ -e $lock/confirmed ]] && break
    sleep 0.2
  done
  [[ -e $lock/confirmed ]] || hyprctl reload >/dev/null || true
  rm -rf "$lock"
}

cmd_confirm() {
  if ! live_countdown_pid >/dev/null; then
    echo "nothing to confirm"
    exit 1
  fi
  touch "$LOCK/confirmed" 2>/dev/null || true
  local i
  for ((i = 0; i < 20; i++)); do
    [[ -d $LOCK ]] || break
    sleep 0.1
  done
}

cmd_revert() {
  local pid
  if pid=$(live_countdown_pid); then
    kill "$pid" 2>/dev/null || true
  fi
  if ! hyprctl reload >/dev/null; then
    rm -rf "$LOCK"
    echo "omarchy-displays: hyprctl reload failed" >&2
    exit 1
  fi
  rm -rf "$LOCK"
}

# Epoch suffix for the next backup: always newer than every existing one, so
# rotation by suffix keeps the newest even when persists share a second.
next_backup_ts() {
  local ts newest=0 f n
  ts=$(date +%s)
  for f in "$HYPR_DIR"/displays.lua.bak.*; do
    n=${f##*.bak.}
    if [[ $n =~ ^[0-9]+$ ]] && ((10#$n > newest)); then newest=$((10#$n)); fi
  done
  ((ts > newest)) || ts=$((newest + 1))
  echo "$ts"
}

prune_backups() {
  local f n
  for f in "$HYPR_DIR"/displays.lua.bak.*; do
    n=${f##*.bak.}
    if [[ $n =~ ^[0-9]+$ ]]; then echo "$n"; fi
  done | sort -rn | tail -n +$((KEEP_BACKUPS + 1)) | while read -r n; do
    rm -f "$HYPR_DIR/displays.lua.bak.$n"
  done
}

# The active profile's name, or nothing when none is set.
active_name() {
  local name=""
  if [[ -f $ACTIVE ]]; then IFS= read -r name <"$ACTIVE" || true; fi
  printf '%s' "$name"
}

# Atomic write of one file in the config tree from stdin.
store_file() {
  local dest=$1 tmp
  mkdir -p "$(dirname "$dest")"
  tmp=$(mktemp "$(dirname "$dest")/.tmp.XXXXXX")
  TMP_FILE=$tmp
  cat >"$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$dest"
  TMP_FILE=
}

check_name() {
  [[ $1 =~ $NAME_RE ]] || reject "invalid profile name '$1': 1 to 40 characters of [A-Za-z0-9 _-], starting with a letter or digit, not ending in a space"
}

# "<mtime>\t<name>" per stored profile, newest first, ties by name.
profiles_by_recency() {
  local f n
  for f in "$PROFILES"/*.json; do
    [[ -f $f ]] || continue
    n=$(basename "$f" .json)
    [[ $n =~ $NAME_RE ]] || continue
    printf '%s\t%s\n' "$(stat -c %Y "$f")" "$n"
  done | sort -t$'\t' -k1,1nr -k2,2
}

stored_profile() { # name -> path, exit 3 unless it exists
  check_name "$1"
  [[ -f $PROFILES/$1.json ]] || reject "no such profile: $1"
  printf '%s' "$PROFILES/$1.json"
}

# Rules for every identity that a stored profile has and the chosen profile
# lacks, so an unplugged monitor keeps its rule. The most recently modified
# profile holding an identity supplies it.
fallback_lines() { # chosen-file chosen-name
  local seen mtime from id f
  seen=$(jq -c '[.monitors[].identity]' "$1")
  while IFS=$'\t' read -r mtime from; do
    f=$PROFILES/$from.json
    if [[ -n $(profile_problems "$f" 2>/dev/null || echo bad) ]]; then continue; fi
    while IFS= read -r id; do
      printf -- '-- from profile %s: monitor not in %s\n' "$from" "$2"
      rules_of "$f" "$id"
      seen=$(jq -c --arg id "$id" '. + [$id]' <<<"$seen")
    done < <(jq -r --argjson seen "$seen" '[.monitors[].identity | select(. as $i | $seen | index($i) | not)] | unique[]' "$f")
  done < <(profiles_by_recency)
}

cmd_persist() {
  local file="" empty=0
  while (($#)); do
    case $1 in
      --empty) empty=1; shift ;;
      -*) reject "unknown option $1" ;;
      *)
        [[ -z $file ]] || reject "persist takes one profile file"
        file=$1
        shift
        ;;
    esac
  done

  local name="(none)" rules=() active
  if ((empty)); then
    [[ -z $file ]] || reject "--empty takes no profile file"
  else
    if [[ -z $file ]]; then
      active=$(active_name)
      if [[ -f $LAST_APPLIED ]]; then
        file=$LAST_APPLIED
      elif [[ $active =~ $NAME_RE && -f $PROFILES/$active.json ]]; then
        file=$PROFILES/$active.json
      fi
    fi
    [[ -f $file ]] || reject "no profile to persist: pass a file, apply one, or activate a saved profile"
    validate_profile "$file"
    name=$(jq -r .name "$file")
    mapfile -t rules < <(rules_of "$file"; fallback_lines "$file" "$name")
  fi

  local dest="$HYPR_DIR/displays.lua" tmp
  mkdir -p "$HYPR_DIR"
  tmp=$(mktemp "$dest.tmp.XXXXXX")
  TMP_FILE=$tmp
  {
    printf '%s\n' "-- Generated by omarchy-displays $VERSION. Do not edit: the next persist overwrites it." \
      "-- Profile: $name" \
      "OMARCHY_DISPLAYS_LOADED = \"$VERSION\""
    if ((${#rules[@]})); then
      printf '%s\n' "${rules[@]}"
    fi
  } >"$tmp"
  chmod 644 "$tmp"

  if [[ -e $dest ]]; then
    cp -p "$dest" "$dest.bak.$(next_backup_ts)"
  fi
  mv -f "$tmp" "$dest"
  TMP_FILE=
  prune_backups

  if ! hyprctl reload >/dev/null; then
    echo "omarchy-displays: wrote $dest but hyprctl reload failed" >&2
    exit 1
  fi
  echo "persisted $name to $dest"
}

cmd_profile_list() {
  local active f n
  active=$(active_name)
  for f in "$PROFILES"/*.json; do
    [[ -f $f ]] || continue
    n=$(basename "$f" .json)
    [[ $n =~ $NAME_RE ]] || continue
    jq -c --arg n "$n" --arg a "$active" --argjson m "$(stat -c %Y "$f")" \
      '{name: $n, active: ($n == $a), identities: [.monitors[]?.identity], modified: $m}' "$f" 2>/dev/null || true
  done | jq -s 'sort_by(.name)'
}

cmd_profile_save() {
  local file="" name="" activate=0
  while (($#)); do
    case $1 in
      --name)
        [[ -n ${2:-} ]] || reject "--name needs a value"
        name=$2
        shift 2
        ;;
      --activate) activate=1; shift ;;
      -*) reject "unknown option $1" ;;
      *)
        [[ -z $file ]] || reject "profile save takes one profile file"
        file=$1
        shift
        ;;
    esac
  done
  [[ -n $file ]] || reject "profile save needs a profile file"
  validate_profile "$file"
  [[ -n $name ]] || name=$(jq -r .name "$file")
  check_name "$name"
  jq --arg n "$name" '.name = $n' "$file" | store_file "$PROFILES/$name.json"
  if ((activate)); then set_active "$name"; fi
  echo "saved $name"
}

cmd_profile_delete() {
  local path
  path=$(stored_profile "${1:-}")
  rm -f "$path"
  if [[ $(active_name) == "$1" ]]; then rm -f "$ACTIVE"; fi
}

# Activating also drops last-applied.json, or a bare persist would still write
# the profile apply saw last instead of the one just activated.
set_active() {
  printf '%s\n' "$1" | store_file "$ACTIVE"
  rm -f "$LAST_APPLIED"
}

cmd_profile_activate() {
  stored_profile "${1:-}" >/dev/null
  set_active "$1"
}

# The stored profile whose identity set equals the connected monitors', the
# active one first when several do.
cmd_profile_match() {
  local present active mtime n hit=""
  present=$(cmd_state | jq -c '[.[].identity] | unique')
  active=$(active_name)
  while IFS=$'\t' read -r mtime n; do
    jq -e --argjson p "$present" '([.monitors[]?.identity] | unique) == $p' "$PROFILES/$n.json" >/dev/null 2>&1 || continue
    if [[ $n == "$active" ]]; then hit=$n; break; fi
    [[ -n $hit ]] || hit=$n
  done < <(profiles_by_recency)
  [[ -n $hit ]] || exit 1
  echo "$hit"
}

cmd_profile() {
  local sub=${1:-} path
  shift || true
  case $sub in
    list) cmd_profile_list ;;
    show) path=$(stored_profile "${1:-}") && jq . "$path" ;;
    save) cmd_profile_save "$@" ;;
    delete) cmd_profile_delete "$@" ;;
    activate) cmd_profile_activate "$@" ;;
    match) cmd_profile_match ;;
    *) reject "profile needs list, show, save, delete, activate or match" ;;
  esac
}

cmd_doctor() {
  local missing=0 reply
  if grep -qF -- "$LOADER_LINE" "$HYPR_DIR/hyprland.lua" 2>/dev/null; then
    :
  else
    echo "missing: $LOADER_LINE is not in $HYPR_DIR/hyprland.lua (run install.sh)"
    missing=1
  fi
  # eval answers only ok or an error, never a value, so the check is an assert.
  # Any version proves the file is loaded; a mismatch is a note, not a
  # failure, or every upgrade would fail doctor until the next persist.
  if reply=$(hyprctl eval 'assert(OMARCHY_DISPLAYS_LOADED ~= nil)' 2>&1) && [[ $reply == ok ]]; then
    if ! hyprctl eval "assert(OMARCHY_DISPLAYS_LOADED == \"$VERSION\")" >/dev/null 2>&1; then
      echo "note: displays.lua was generated by another version; run omarchy-displays persist to refresh it"
    fi
  else
    echo "missing: the running config has no OMARCHY_DISPLAYS_LOADED (${reply:-no reply}); run omarchy-displays persist"
    missing=1
  fi
  ((missing == 0)) || exit 1
  echo "ok: $LOADER_LINE is live"
}

case "${1:-}" in
  state) cmd_state ;;
  apply) shift; cmd_apply "$@" ;;
  confirm) cmd_confirm ;;
  revert) cmd_revert ;;
  status) cmd_status ;;
  persist) shift; cmd_persist "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  doctor) cmd_doctor ;;
  loader-line) echo "$LOADER_LINE" ;;
  version) echo "$VERSION" ;;
  _countdown) shift; cmd_countdown "$@" ;;
  help | -h | --help | "") usage ;;
  *)
    usage >&2
    exit 3
    ;;
esac
